# Másold .env.local néven (valódi kulcsot soha ne commitolj). Vercelen: Settings → Environment Variables.

# AI-szövegsegéd (Google Gemini). Kulcs nélkül minden más működik.
GEMINI_API_KEY=
# Opcionális: a próbált modellek sorrendje, vesszővel elválasztva.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.6-flash

# Stripe — közös fiók a DoneSignIn-nel és a ConvertPDFNow-val; minden GetProCV-objektum metadata.app = "getprocv".
# Teszt-kulcsok: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Opcionális: meglévő Price ID-k. Üresen az alkalmazás egyszer létrehozza (és utána újrahasználja)
# a GetProCV árait: 4,99 € egyszeri díj a 7 napos időszakra, 9,99 €/hó előfizetés.
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_MONTHLY=

# A belépési sütiket írja alá. Bármilyen hosszú véletlen szöveg (pl. `openssl rand -hex 32`).
SESSION_SECRET=

# Belépési kódok e-mailben a https://resend.com-on keresztül. Kulcs nélkül a kód a szervernaplóba kerül
# (csak fejlesztéshez — élesben kulcs nélkül a kódos belépés nem működik).
RESEND_API_KEY=
EMAIL_FROM="GetProCV <no-reply@getprocv.com>"

# Az élő oldal címe (Stripe-visszatérés és -portál, canonical, hreflang). Vercel productionben alapból https://getprocv.com.
NEXT_PUBLIC_SITE_URL=
